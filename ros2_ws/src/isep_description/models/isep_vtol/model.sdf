            </ode>
          </friction>
        </surface>
      </collision>
      <sensor name="camera" type="camera">
        <pose>0.14 0 -0.08 0 0.523599 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>isep_vtol/camera/image</topic>
        <camera>
          <horizontal_fov>1.15192</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>300</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="lidar_2d" type="gpu_lidar">
        <pose>0.1 0 0.095 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>isep_vtol/lidar/scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
      <sensor name="rangefinder_down" type="gpu_lidar">
        <pose>-0.05 0 -0.1 0 1.5708 0</pose>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <topic>isep_vtol/rangefinder</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.3</min>
            <max>20</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>

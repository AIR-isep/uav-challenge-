<?xml version="1.0"?>
<sdf version="1.9">
  <model name="isep_vtol">
    <!-- FICHIER GÉNÉRÉ par scripts/generate_model.py depuis config/isep_vtol.yaml : ne pas éditer -->
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">

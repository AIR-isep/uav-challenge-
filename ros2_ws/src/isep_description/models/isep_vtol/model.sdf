        </inertia>
      </inertial>
      <visual name="airframe">
        <pose>0.2 0 -0.1 0 0 1.5708</pose>
        <geometry>
          <mesh>
            <uri>model://isep_vtol/meshes/drone_simulation.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isep_mission</name>
  <version>0.1.0</version>
  <description>Machine à états de mission du drone isep_vtol, pilotage d'ArduPilot via MAVROS.</description>
  <maintainer email="equipe-air@isep.fr">Équipe AIR ISEP</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>isep_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
